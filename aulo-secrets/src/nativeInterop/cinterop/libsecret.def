package = aulo.secrets.libsecret
# glibc before 2.34 keeps dlopen in libdl; the Kotlin/Native sysroot is older.
linkerOpts = -ldl
---
/*
 * The Secret Service through the system's libsecret, opened with dlopen so aulo links no LGPL
 * code and runs where libsecret is absent. libsecret's and glib's headers are not in the
 * Kotlin/Native sysroot, so the few types used are declared here as their stable ABI is
 * documented (libsecret 0.18+: SecretSchema, GError, GHashTable of strings).
 */
#include <dlfcn.h>
#include <stdlib.h>
#include <string.h>

typedef struct { const char *name; int type; } aulo_secret_attribute;

typedef struct {
    const char *name;
    int flags;
    aulo_secret_attribute attributes[32];
    int reserved;
    void *reserved1, *reserved2, *reserved3, *reserved4, *reserved5, *reserved6, *reserved7;
} aulo_secret_schema;

typedef struct { unsigned int domain; int code; char *message; } aulo_gerror;

typedef void *(*aulo_hash_new_fn)(void *hash, void *equal);
typedef int (*aulo_hash_insert_fn)(void *table, void *key, void *value);
typedef void (*aulo_hash_unref_fn)(void *table);
typedef void (*aulo_error_free_fn)(aulo_gerror *error);
typedef int (*aulo_store_fn)(const aulo_secret_schema *, void *, const char *, const char *, const char *, void *, aulo_gerror **);
typedef char *(*aulo_lookup_fn)(const aulo_secret_schema *, void *, void *, aulo_gerror **);
typedef int (*aulo_clear_fn)(const aulo_secret_schema *, void *, void *, aulo_gerror **);
typedef void (*aulo_password_free_fn)(char *);

static struct {
    aulo_hash_new_fn hash_new;
    aulo_hash_insert_fn hash_insert;
    aulo_hash_unref_fn hash_unref;
    void *str_hash;
    void *str_equal;
    aulo_error_free_fn error_free;
    aulo_store_fn store;
    aulo_lookup_fn lookup;
    aulo_clear_fn clear;
    aulo_password_free_fn password_free;
} aulo_secret_api;

/* Every item aulo writes: schema app.aulo.Secret, one string attribute "account". */
static const aulo_secret_schema aulo_secret_schema_v1 = {
    "app.aulo.Secret", 0, { { "account", 0 }, { NULL, 0 } }, 0, NULL, NULL, NULL, NULL, NULL, NULL, NULL
};

/* Opens libsecret once; NULL on success, else why not. Call from one thread before the rest. */
static const char *aulo_secret_open(void) {
    void *h = dlopen("libsecret-1.so.0", RTLD_NOW | RTLD_LOCAL);
    if (h == NULL) return "libsecret-1.so.0 is not installed";
    /* dlsym on the handle also searches its dependencies, glib among them. */
    aulo_secret_api.hash_new = (aulo_hash_new_fn) dlsym(h, "g_hash_table_new");
    aulo_secret_api.hash_insert = (aulo_hash_insert_fn) dlsym(h, "g_hash_table_insert");
    aulo_secret_api.hash_unref = (aulo_hash_unref_fn) dlsym(h, "g_hash_table_unref");
    aulo_secret_api.str_hash = dlsym(h, "g_str_hash");
    aulo_secret_api.str_equal = dlsym(h, "g_str_equal");
    aulo_secret_api.error_free = (aulo_error_free_fn) dlsym(h, "g_error_free");
    aulo_secret_api.store = (aulo_store_fn) dlsym(h, "secret_password_storev_sync");
    aulo_secret_api.lookup = (aulo_lookup_fn) dlsym(h, "secret_password_lookupv_sync");
    aulo_secret_api.clear = (aulo_clear_fn) dlsym(h, "secret_password_clearv_sync");
    aulo_secret_api.password_free = (aulo_password_free_fn) dlsym(h, "secret_password_free");
    if (!aulo_secret_api.hash_new || !aulo_secret_api.hash_insert || !aulo_secret_api.hash_unref || !aulo_secret_api.str_hash
        || !aulo_secret_api.str_equal || !aulo_secret_api.error_free || !aulo_secret_api.store || !aulo_secret_api.lookup
        || !aulo_secret_api.clear || !aulo_secret_api.password_free) {
        dlclose(h);
        memset(&aulo_secret_api, 0, sizeof aulo_secret_api);
        return "libsecret-1.so.0 lacks the functions aulo needs";
    }
    return NULL;
}

static void *aulo_secret_attributes(const char *account) {
    void *table = aulo_secret_api.hash_new(aulo_secret_api.str_hash, aulo_secret_api.str_equal);
    if (table != NULL) aulo_secret_api.hash_insert(table, (void *) "account", (void *) account);
    return table;
}

/* Moves a GError's message into malloc'd memory the caller frees; NULL error stays NULL. */
static char *aulo_secret_take_error(aulo_gerror *error) {
    if (error == NULL) return NULL;
    char *message = strdup(error->message != NULL ? error->message : "unknown error");
    aulo_secret_api.error_free(error);
    return message;
}

/* 1 when stored; else 0 and *error_out a malloc'd message. */
static int aulo_secret_store(const char *account, const char *label, const char *password, char **error_out) {
    aulo_gerror *error = NULL;
    void *attributes = aulo_secret_attributes(account);
    if (attributes == NULL) { *error_out = strdup("out of memory"); return 0; }
    int ok = aulo_secret_api.store(&aulo_secret_schema_v1, attributes, "default", label, password, NULL, &error);
    aulo_secret_api.hash_unref(attributes);
    *error_out = aulo_secret_take_error(error);
    return ok && *error_out == NULL;
}

/* A malloc'd copy of the secret, or NULL with *error_out NULL when there is none. */
static char *aulo_secret_lookup(const char *account, char **error_out) {
    aulo_gerror *error = NULL;
    void *attributes = aulo_secret_attributes(account);
    if (attributes == NULL) { *error_out = strdup("out of memory"); return NULL; }
    char *found = aulo_secret_api.lookup(&aulo_secret_schema_v1, attributes, NULL, &error);
    aulo_secret_api.hash_unref(attributes);
    *error_out = aulo_secret_take_error(error);
    if (found == NULL) return NULL;
    char *copy = strdup(found);
    /* secret_password_free wipes before it frees. */
    aulo_secret_api.password_free(found);
    return copy;
}

/* 1 when something was removed, 0 when nothing was; on failure 0 and *error_out set. */
static int aulo_secret_clear(const char *account, char **error_out) {
    aulo_gerror *error = NULL;
    void *attributes = aulo_secret_attributes(account);
    if (attributes == NULL) { *error_out = strdup("out of memory"); return 0; }
    int removed = aulo_secret_api.clear(&aulo_secret_schema_v1, attributes, NULL, &error);
    aulo_secret_api.hash_unref(attributes);
    *error_out = aulo_secret_take_error(error);
    return removed;
}

/* Wipes and frees what aulo_secret_lookup returned. */
static void aulo_secret_free(char *secret) {
    if (secret == NULL) return;
    volatile char *p = secret;
    while (*p) *p++ = 0;
    free(secret);
}
