{
  "$defs": {
    "Model": {
      "additionalProperties": false,
      "description": "A model: a directory of files that are installed together.",
      "properties": {
        "base_url": {
          "description": "Immutable location (a Hugging Face commit or a release tag) ending in `/`.",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ModelFile"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "description": "Directory name under `<AULO_HOME>/models/`.",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ModelKind"
        },
        "license": {
          "description": "SPDX identifier; shown before a download because some licences need attribution.",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "license",
        "base_url",
        "files"
      ],
      "type": "object"
    },
    "ModelFile": {
      "additionalProperties": false,
      "description": "One downloadable file. The size is also the download cap.",
      "properties": {
        "path": {
          "description": "Path relative to the model directory and to `base_url`; no `..`.",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the file.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "description": "Exact size in bytes.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "ModelKind": {
      "description": "Which speech role a model fills.",
      "enum": [
        "stt",
        "tts",
        "vad",
        "kws"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The set of models aulo knows how to download.",
  "properties": {
    "models": {
      "items": {
        "$ref": "#/$defs/Model"
      },
      "type": "array"
    }
  },
  "required": [
    "models"
  ],
  "title": "Catalog",
  "type": "object"
}
