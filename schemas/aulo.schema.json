{
  "$defs": {
    "BargeIn": {
      "description": "What speaking over aulo does to the turn in progress.",
      "oneOf": [
        {
          "const": "interrupt",
          "description": "Stop playback and cancel the turn.",
          "type": "string"
        },
        {
          "const": "continue",
          "description": "Stop playback; the turn keeps running.",
          "type": "string"
        }
      ]
    },
    "DaemonConfig": {
      "additionalProperties": false,
      "description": "`aulod` transport.",
      "properties": {
        "listen": {
          "description": "TCP address for remote clients. Unset: the owner-only local socket only.",
          "type": "string"
        },
        "tls_cert": {
          "description": "Certificate for `listen`. TLS is required whenever `listen` is set.",
          "type": "string"
        },
        "tls_key": {
          "description": "Private key for `tls_cert`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "EngineConfig": {
      "additionalProperties": false,
      "description": "Shape shared by `[voice.stt]` and `[voice.tts]`.",
      "properties": {
        "engine": {
          "type": "string"
        },
        "fallback": {
          "default": [],
          "description": "Engines tried in order when the chosen one fails.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "model": {
          "type": "string"
        },
        "rate": {
          "format": "float",
          "type": "number"
        },
        "voice": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ListenMode": {
      "enum": [
        "push-to-talk",
        "wake-word"
      ],
      "type": "string"
    },
    "McpConfig": {
      "additionalProperties": false,
      "properties": {
        "servers": {
          "additionalProperties": {
            "$ref": "#/$defs/McpServer"
          },
          "default": {},
          "description": "MCP servers aulo connects to, by name.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "McpServer": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "command": {
              "type": "string"
            },
            "transport": {
              "const": "stdio",
              "type": "string"
            }
          },
          "required": [
            "transport",
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "transport": {
              "const": "http",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "transport",
            "url"
          ],
          "type": "object"
        }
      ]
    },
    "PluginsConfig": {
      "additionalProperties": false,
      "properties": {
        "dirs": {
          "default": [],
          "description": "Extra directories scanned for plugins.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "disabled": {
          "default": [],
          "description": "Plugin ids that are never loaded.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "approval_timeout_secs": {
          "default": 60,
          "description": "An approval request nobody answers within this time is denied.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "ask": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deny": {
          "default": [],
          "description": "Rules in the perm-rules grammar. Evaluation order is deny, allow, ask.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "description": "Overrides the provider's default endpoint; required for `openai-compatible`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ProviderKind": {
      "enum": [
        "runa",
        "ollama",
        "lm-studio",
        "llama-cpp",
        "openai",
        "anthropic",
        "gemini",
        "xai",
        "openrouter",
        "deepseek",
        "openai-compatible"
      ],
      "type": "string"
    },
    "ProvidersConfig": {
      "additionalProperties": false,
      "description": "Model providers and the tiers that route to them. API keys are not\nconfiguration: they live in the OS keychain.",
      "properties": {
        "endpoints": {
          "additionalProperties": {
            "$ref": "#/$defs/ProviderConfig"
          },
          "default": {},
          "description": "Named provider endpoints that tiers refer to.",
          "type": "object"
        },
        "tiers": {
          "$ref": "#/$defs/TiersConfig",
          "default": {}
        }
      },
      "type": "object"
    },
    "TierConfig": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "description": "Name of an entry in `providers.endpoints`.",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "TiersConfig": {
      "additionalProperties": false,
      "description": "One provider and model per tier; an unset tier is not configured.",
      "properties": {
        "cheap": {
          "$ref": "#/$defs/TierConfig",
          "description": "Titles and summaries."
        },
        "main": {
          "$ref": "#/$defs/TierConfig",
          "description": "Tool use."
        },
        "sentinel": {
          "$ref": "#/$defs/TierConfig",
          "description": "The reviewer of consequential actions."
        },
        "voice": {
          "$ref": "#/$defs/TierConfig",
          "description": "Fast short answers, or the realtime front."
        }
      },
      "type": "object"
    },
    "VoiceConfig": {
      "additionalProperties": false,
      "properties": {
        "barge_in": {
          "$ref": "#/$defs/BargeIn",
          "default": "interrupt"
        },
        "listen": {
          "$ref": "#/$defs/ListenMode",
          "default": "push-to-talk"
        },
        "stt": {
          "$ref": "#/$defs/EngineConfig",
          "default": {
            "fallback": []
          }
        },
        "tts": {
          "$ref": "#/$defs/EngineConfig",
          "default": {
            "fallback": []
          }
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `config.toml` and `.aulo.toml`.",
  "properties": {
    "daemon": {
      "$ref": "#/$defs/DaemonConfig",
      "default": {}
    },
    "mcp": {
      "$ref": "#/$defs/McpConfig",
      "default": {
        "servers": {}
      }
    },
    "plugins": {
      "$ref": "#/$defs/PluginsConfig",
      "default": {
        "dirs": [],
        "disabled": []
      }
    },
    "policy": {
      "$ref": "#/$defs/PolicyConfig",
      "default": {
        "allow": [],
        "approval_timeout_secs": 60,
        "ask": [],
        "deny": []
      }
    },
    "providers": {
      "$ref": "#/$defs/ProvidersConfig",
      "default": {
        "endpoints": {},
        "tiers": {}
      }
    },
    "voice": {
      "$ref": "#/$defs/VoiceConfig",
      "default": {
        "barge_in": "interrupt",
        "listen": "push-to-talk",
        "stt": {
          "fallback": []
        },
        "tts": {
          "fallback": []
        }
      }
    }
  },
  "title": "Config",
  "type": "object"
}
